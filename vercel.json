{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/travaux/activites-fle/interactives",
      "destination": "/videos-interactives/",
      "permanent": true
    },
    {
      "source": "/travaux/activites-fle/ville",
      "destination": "/jeu/",
      "permanent": true
    },
    {
      "source": "/travaux/activites-fle/village",
      "destination": "/jeu/village/",
      "permanent": true
    },
    {
      "source": "/travaux/activites-fle",
      "destination": "/activites/",
      "permanent": true
    },
    {
      "source": "/travaux/activites-fle/interactives/:chemin*",
      "destination": "/videos-interactives/:chemin*",
      "permanent": true
    },
    {
      "source": "/travaux/activites-fle/ville/:chemin*",
      "destination": "/jeu/:chemin*",
      "permanent": true
    },
    {
      "source": "/travaux/activites-fle/village/:chemin*",
      "destination": "/jeu/village/:chemin*",
      "permanent": true
    },
    {
      "source": "/travaux/activites-fle/:chemin*",
      "destination": "/activites/:chemin*",
      "permanent": true
    }
  ]
}
